# =============================================================================
# Arunalu ASM — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Django (Backend)
# -----------------------------------------------------------------------------
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames (no spaces)
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_NAME=aas_db
DB_USER=aas_user
DB_PASSWORD=your-strong-db-password-here
DB_HOST=db
DB_PORT=5432

# -----------------------------------------------------------------------------
# AWS (Rekognition)
# IMPORTANT: Rotate credentials immediately if they were ever committed to git.
# Create a least-privilege IAM user with only rekognition:* permissions.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REKOGNITION_REGION=us-east-2

# -----------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# -----------------------------------------------------------------------------
# Frontend (React)
# -----------------------------------------------------------------------------
REACT_APP_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Mobile (React Native)
# -----------------------------------------------------------------------------
API_URL=http://localhost:8000
