# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost

# Database
DATABASE_NAME=aas_db
DATABASE_USER=aas_user
DATABASE_PASSWORD=your-db-password-here
DATABASE_HOST=db
DATABASE_PORT=5432

# AWS Credentials for Rekognition
# IMPORTANT: Never commit real credentials. Rotate immediately if exposed.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REKOGNITION_REGION=us-east-2

# CORS (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
